
{
  "package": "janitorai-creator-community",
  "version": "1.0.0",
  "document_status": "reconstructed",
  "source_policy": {
    "original_files_included": false,
    "description": "Independently reconstructed community guides, not byte-for-byte copies of the original GPT knowledge files."
  },
  "primary_prompt": "prompts/master-instructions.md",
  "knowledge": [
    {
      "id": "creator-master",
      "file": "knowledge/01-Advanced-Creator-Master-Guide.pdf",
      "purpose": "Character architecture, Janitor AI formatting, workflows",
      "priority": "required_for_bot_creation"
    },
    {
      "id": "character-psychology",
      "file": "knowledge/02-Character-Psychology.pdf",
      "purpose": "Motivation, attachment, defenses, emotional realism",
      "priority": "general_character_design"
    },
    {
      "id": "sexuality-intimacy",
      "file": "knowledge/03-Sexuality-and-Intimacy.pdf",
      "purpose": "Adult relationships, identity, intimacy, boundaries",
      "priority": "conditional"
    },
    {
      "id": "cross-cultural-english",
      "file": "knowledge/04-Cross-Cultural-English.pdf",
      "purpose": "Multilingual communication, accents, speech authenticity",
      "priority": "when_relevant"
    },
    {
      "id": "portable-personas",
      "file": "knowledge/05-Portable-User-Personas.pdf",
      "purpose": "Character bibles, compact personas, adaptations, canon",
      "priority": "required_for_persona_creation"
    }
  ],
  "defaults": {
    "persona_outputs": [
      "full_character_bible",
      "compact_persona"
    ],
    "preserve_core_canon": true,
    "roleplay_histories_are_separate": true,
    "automatic_canon_promotion": false,
    "allow_persona_to_bot_conversion": true
  },
  "supported_operations": [
    "create_character",
    "revise_character",
    "create_user_persona",
    "revise_user_persona",
    "adapt_persona_to_bot",
    "update_persona_canon",
    "promote_persona_to_character"
  ]
}
